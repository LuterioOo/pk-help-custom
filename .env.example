# =============================================================================
# PK-HELP Custom — environment variables (NEVER commit real values)
#
# Local:
#   copy .env.local.example .env.local
#   (or copy this file to .env.local and fill in)
#   npm run db:setup && npm run dev
#
# Production (Vercel → Environment Variables):
#   NEXT_PUBLIC_SITE_URL=https://pkcustompredfinal.vercel.app
#   See README_DEPLOY.md and FINAL_REPORT.md
# =============================================================================

# --- Database (required) ---
# Neon: Dashboard → Connection string → Pooled → add ?sslmode=require if missing
DATABASE_URL="postgresql://USER:PASSWORD@ep-xxx-pooler.region.aws.neon.tech/neondb?sslmode=require"

# --- Public site URL (required) ---
# Local:
NEXT_PUBLIC_SITE_URL="http://localhost:3000"
# Vercel (set in dashboard, not in committed files):
# NEXT_PUBLIC_SITE_URL="https://pkcustompredfinal.vercel.app"

# --- Domains (production / custom domains) ---
NEXT_PUBLIC_MAIN_DOMAIN="pk-help.pl"
NEXT_PUBLIC_POLISH_DOMAIN="pk-help-pl.pl"
# Full URL of Polish site (for redirects from main domain /pl)
# NEXT_PUBLIC_POLISH_SITE_URL="https://pk-help-pl.pl"

# Force Polish locale on any host (optional, for testing)
# NEXT_PUBLIC_FORCE_LOCALE=pl

# --- Admin auth (required in production) ---
JWT_SECRET="change-me-min-32-random-characters-long"
ADMIN_USERNAME="admin"
ADMIN_PASSWORD="change-me-strong-password"

# --- Telegram order notifications (recommended) ---
# Create bot via @BotFather, add bot to group/channel, get chat id via getUpdates
TELEGRAM_BOT_TOKEN=""
TELEGRAM_CHAT_ID=""

# --- CRM (Kommo) — optional; orders still save if unset ---
# REQUIRED: long-lived token only (Secret key is NOT used by the site)
CRM_PROVIDER="kommo"
CRM_ACCESS_TOKEN=""
# RECOMMENDED: subdomain from browser when logged in to Kommo
# CRM_API_URL="https://yourcompany.kommo.com"
# OR: CRM_SUBDOMAIN="yourcompany"
# Optional API host (auto-detected from token as api-c.kommo.com if omitted)
# CRM_API_DOMAIN="api-c.kommo.com"
# CRM_API_KEY=""  # alias for CRM_ACCESS_TOKEN
# Wrong pipeline id breaks lead create — leave empty until you know the id
# CRM_PIPELINE_ID=""
# CRM_RESPONSIBLE_USER_ID=""  # defaults to user id from token

# --- Public links (optional) ---
NEXT_PUBLIC_TELEGRAM_URL="https://t.me/your_channel"
NEXT_PUBLIC_INSTAGRAM_URL="https://instagram.com/your_profile"
NEXT_PUBLIC_GOOGLE_MAPS_EMBED_URL=""

# --- Vercel Blob (required for admin image uploads on Vercel) ---
# Created automatically when you connect Blob storage in Vercel project
# BLOB_READ_WRITE_TOKEN=""

# --- Rate limiting (optional) ---
# RATE_LIMIT_MAX=5
# RATE_LIMIT_WINDOW_MS=60000
