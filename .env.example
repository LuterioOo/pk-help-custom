# =============================================================================
# PK-HELP Custom - environment variables
#
# IMPORTANT (Neon vs localhost):
#   Next.js reads .env.local over .env
#   Prisma CLI (db:push) uses scripts/with-env.mjs -> .env.local wins too
#   Put Neon DATABASE_URL in .env.local
#   Remove or comment DATABASE_URL in .env if it still points to localhost:5432
#
# Setup:
#   copy .env.example .env.local
#   fill DATABASE_URL (Neon pooled URL)
#   npm run db:setup
#
# Production: set vars in Vercel dashboard (never commit .env / .env.local)
# =============================================================================

# --- Database (required) — prefer .env.local for local Neon ---
# Neon: Connection string -> Pooled -> add ?sslmode=require if missing
DATABASE_URL="postgresql://neondb_owner:npg_Uh9zx5vOtckE@ep-young-bird-alp7igj3-pooler.c-3.eu-central-1.aws.neon.tech/neondb?sslmode=require&channel_binding=require"

# --- Site URL (required in production) ---
NEXT_PUBLIC_SITE_URL="https://pkcustompredfinal.vercel.app/"

# --- Domains (production) ---
NEXT_PUBLIC_MAIN_DOMAIN="pk-help.pl"
NEXT_PUBLIC_POLISH_DOMAIN="pk-help-pl.pl"

# NEXT_PUBLIC_FORCE_LOCALE=pl

# --- Admin auth (required in production) ---
JWT_SECRET="change-me-min-32-random-characters-long"
ADMIN_USERNAME="admin"
ADMIN_PASSWORD="change-me-strong-password"

# --- Telegram (recommended for order notifications) ---
# Create bot via @BotFather, add bot to group/channel, get chat id via getUpdates
TELEGRAM_BOT_TOKEN=""
TELEGRAM_CHAT_ID=""

# --- Public links (optional) ---
NEXT_PUBLIC_TELEGRAM_URL="https://t.me/your_channel"
NEXT_PUBLIC_INSTAGRAM_URL="https://instagram.com/your_profile"
NEXT_PUBLIC_GOOGLE_MAPS_EMBED_URL=""

# --- Vercel Blob (required for admin uploads in production) ---
# BLOB_READ_WRITE_TOKEN=""

# RATE_LIMIT_MAX=5
# RATE_LIMIT_WINDOW_MS=60000
