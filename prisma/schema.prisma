generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum ComponentCategory {
  CASE
  CPU
  MOTHERBOARD
  GPU
  RAM
  SSD
  HDD
  PSU
  COOLER
  AIO
  FANS
}

enum OrderStatus {
  NOWE
  W_TRAKCIE
  WYCENIONE
  estimated_waiting_service
  ZAKONCZONE
  ANULOWANE
}

enum CrmSyncStatus {
  PENDING
  SYNCED
  FAILED
  SKIPPED
}

model Component {
  id                   String            @id @default(cuid())
  category             ComponentCategory
  name                 String
  nameUk               String?
  nameEn               String?
  namePl               String?
  brand                String
  model                String?
  socket               String?
  chipset              String?
  wattage              Int?
  capacity             String?
  memoryType           String?
  formFactor           String?
  baseMarketPricePLN   Float             @default(0)
  markupPLN            Float             @default(0)
  price                Float
  usedPrice            Float?
  sourceUrl            String?
  externalPriceUrl     String?
  externalStoreName    String?
  externalPrice        Float?
  lastPriceSyncAt      DateTime?
  manualPriceOverride  Float?
  imageUrl             String?
  specs                Json              @default("{}")
  popularityScore      Int               @default(0)
  stock                Int               @default(10)
  featured             Boolean           @default(false)
  active               Boolean           @default(true)
  createdAt            DateTime          @default(now())
  updatedAt            DateTime          @updatedAt
}

model Review {
  id        String   @id @default(cuid())
  name      String
  nameUk    String?
  nameEn    String?
  namePl    String?
  avatarUrl String?
  rating    Int      @default(5)
  text      String
  textUk    String?
  textEn    String?
  textPl    String?
  active    Boolean  @default(true)
  order     Int      @default(0)
  createdAt DateTime @default(now())
}

model Order {
  id         String      @id @default(cuid())
  name       String
  phone      String
  email      String?
  messenger  String?
  services   String[]    @default([])
  comment             String?
  buildJson           Json?
  selectedComponents  Json?
  totalPrice          Float?
  tradeInDiscountPLN  Float?
  tradeInEstimate     Json?
  status     OrderStatus @default(NOWE)
  crmLeadId           String?
  crmDealId           String?
  crmDealUrl          String?
  crmSyncStatus       CrmSyncStatus @default(PENDING)
  crmSyncError        String?
  crmSyncedAt         DateTime?
  createdAt  DateTime    @default(now())
  updatedAt  DateTime    @updatedAt
}

model ShowcaseBuild {
  id                 String   @id @default(cuid())
  imageUrl           String?
  title              String?
  caption            String?
  showText           Boolean  @default(true)
  forSale            Boolean  @default(false)
  pricePLN           Float?
  installmentEnabled Boolean  @default(true)
  tradeInLabel       String?
  sortOrder          Int      @default(0)
  active             Boolean  @default(true)
  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt
}

model Master {
  id             String        @id @default(cuid())
  name           String
  nameUk         String?
  nameEn         String?
  namePl         String?
  avatarUrl      String?
  specialization String?
  specUk         String?
  specEn         String?
  specPl         String?
  description    String?
  sortOrder      Int           @default(0)
  active         Boolean       @default(true)
  builds         MasterBuild[]
  createdAt      DateTime      @default(now())
  updatedAt      DateTime      @updatedAt
}

model MasterBuild {
  id          String   @id @default(cuid())
  masterId    String
  master      Master   @relation(fields: [masterId], references: [id], onDelete: Cascade)
  title       String
  titleUk     String?
  titleEn     String?
  titlePl     String?
  description String?
  imageUrl    String?
  pricePLN    Float?
  sortOrder   Int      @default(0)
  active      Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

model SiteSettings {
  id             String   @id @default("main")
  phone          String   @default("+48 777 777 777")
  email          String   @default("pk-help@gmail.com")
  telegramUrl    String?
  instagramUrl   String?
  mapsEmbedUrl   String?
  heroTitleRu    String?
  heroTitleUk    String?
  heroTitleEn    String?
  heroTitlePl    String?
  heroSubtitleRu String?
  heroSubtitleUk String?
  heroSubtitleEn String?
  heroSubtitlePl String?
  bannerImageUrl String?
  updatedAt      DateTime @updatedAt
}

model AdminUser {
  id           String   @id @default(cuid())
  username     String   @unique
  passwordHash String
  createdAt    DateTime @default(now())
}