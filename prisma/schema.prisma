generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Component {
  id                  String            @id @default(cuid())
  category            ComponentCategory
  name                String
  nameUk              String?
  nameEn              String?
  namePl              String?
  brand               String
  model               String?
  socket              String?
  chipset             String?
  wattage             Int?
  capacity            String?
  memoryType          String?
  formFactor          String?
  baseMarketPricePLN  Float             @default(0)
  markupPLN           Float             @default(0)
  price               Float
  sourceUrl           String?
  imageUrl            String?
  specs               Json              @default("{}")
  popularityScore     Int               @default(0)
  stock               Int               @default(10)
  featured            Boolean           @default(false)
  active              Boolean           @default(true)
  createdAt           DateTime          @default(now())
  updatedAt           DateTime          @updatedAt
  externalPrice       Float?
  externalPriceUrl    String?
  externalStoreName   String?
  lastPriceSyncAt     DateTime?
  manualPriceOverride Float?
  usedPrice           Float?
}

model Review {
  id        String   @id @default(cuid())
  name      String
  nameUk    String?
  nameEn    String?
  namePl    String?
  avatarUrl String?
  rating    Int      @default(5)
  text      String
  textUk    String?
  textEn    String?
  textPl    String?
  active    Boolean  @default(true)
  order     Int      @default(0)
  createdAt DateTime @default(now())
}

model Order {
  id                 String        @id @default(cuid())
  name               String
  phone              String
  email              String?
  messenger          String?
  services           String[]      @default([])
  comment            String?
  buildJson          Json?
  selectedComponents Json?
  totalPrice         Float?
  status             OrderStatus   @default(NOWE)
  createdAt          DateTime      @default(now())
  updatedAt          DateTime      @updatedAt
  crmDealId          String?
  crmDealUrl         String?
  crmLeadId          String?
  crmSyncError       String?
  crmSyncStatus      CrmSyncStatus @default(PENDING)
  crmSyncedAt        DateTime?
  tradeInDiscountPLN Float?
  tradeInEstimate    Json?
}

model ShowcaseBuild {
  id                 String   @id @default(cuid())
  imageUrl           String?
  title              String?
  titleUk            String?
  titleEn            String?
  titlePl            String?
  caption            String?
  captionUk          String?
  captionEn          String?
  captionPl          String?
  showText           Boolean  @default(true)
  forSale            Boolean  @default(false)
  pricePLN           Float?
  sortOrder          Int      @default(0)
  active             Boolean  @default(true)
  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt
  installmentEnabled Boolean  @default(true)
  tradeInLabel       String?
  /// Map of ComponentCategory → component id for «customize ready build» in builder
  presetComponents   Json?
}

model Master {
  id             String        @id @default(cuid())
  name           String
  nameUk         String?
  nameEn         String?
  namePl         String?
  avatarUrl      String?
  specialization String?
  specUk         String?
  specEn         String?
  specPl         String?
  description    String?
  rating         Float         @default(5)
  buildsCount    Int           @default(0)
  sortOrder      Int           @default(0)
  active         Boolean       @default(true)
  createdAt      DateTime      @default(now())
  updatedAt      DateTime      @updatedAt
  builds         MasterBuild[]
}

model MasterBuild {
  id          String   @id @default(cuid())
  masterId    String
  title       String
  titleUk     String?
  titleEn     String?
  titlePl     String?
  description String?
  imageUrl    String?
  pricePLN    Float?
  sortOrder   Int      @default(0)
  active      Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  master      Master   @relation(fields: [masterId], references: [id], onDelete: Cascade)
}

model SiteSettings {
  id             String   @id @default("main")
  phone          String   @default("+48 777 777 777")
  email          String   @default("pk-help@gmail.com")
  telegramUrl    String?
  instagramUrl   String?
  mapsEmbedUrl   String?
  heroTitleRu    String?
  heroTitleUk    String?
  heroTitleEn    String?
  heroTitlePl    String?
  heroSubtitleRu String?
  heroSubtitleUk String?
  heroSubtitleEn String?
  heroSubtitlePl String?
  bannerImageUrl String?
  colorTheme     String   @default("yellow")
  updatedAt      DateTime @updatedAt
}

model AdminUser {
  id           String   @id @default(cuid())
  username     String   @unique
  passwordHash String
  createdAt    DateTime @default(now())
}

enum ComponentCategory {
  CASE
  CPU
  MOTHERBOARD
  GPU
  RAM
  SSD
  HDD
  PSU
  COOLER
  AIO
  FANS
}

enum OrderStatus {
  NOWE
  W_TRAKCIE
  WYCENIONE
  ZAKONCZONE
  ANULOWANE
  estimated_waiting_service
}

enum CrmSyncStatus {
  PENDING
  SYNCED
  FAILED
  SKIPPED
}
